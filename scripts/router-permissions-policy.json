{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeWorkers",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:ap-south-1:714437051269:function:carbon-worker",
        "arn:aws:lambda:eu-north-1:714437051269:function:carbon-worker",
        "arn:aws:lambda:us-east-1:714437051269:function:carbon-worker"
      ]
    },
    {
      "Sid": "DynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:714437051269:table/region_state",
        "arn:aws:dynamodb:ap-south-1:714437051269:table/requests",
        "arn:aws:dynamodb:ap-south-1:714437051269:table/carbon_live"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}